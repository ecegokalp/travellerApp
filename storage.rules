rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Blog images
    match /user_blogs/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Profile pictures
    match /profiles/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Place photos
    match /place_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Trip documents (hotel, flight, place docs)
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}