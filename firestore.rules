rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'followingCount']))
      );

      // Trips, saved_trips, saved_blogs, liked_places, personal_documents: only owner
      match /trips/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /personal_documents/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /saved_trips/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /saved_blogs/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /liked_places/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Followers/Following
      match /followers/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
      match /following/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // Blogs - collectionGroup queries need this rule at {document=**} level
    match /{path=**}/blogs/{blogId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Likes on blogs
    match /{path=**}/likes/{likeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comments on blogs
    match /{path=**}/comments/{commentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Places collection
    match /places/{placeId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
